border-radius: 12px;
}
</style>

<script>
function populateLinks(){
    const headings = document.querySelectorAll('.main-content h1, .main-content h2, .main-content h3, .main-content h4')
    const wrapper = document.querySelector('.links-wrapper')

    wrapper.innerHTML = ''

    let i = 1

    headings.forEach( heading => {
        heading.id = i

        console.log(heading.tagName);

        if(heading.tagName === "H2" || heading.tagName === "H1"){

            wrapper.innerHTML += `<a href="${window.location.href.split(/[?#]/)[0]}#${i}" class="h1-link">${heading.textContent}</a>`
        } else{
            
            wrapper.innerHTML += `<a href="${window.location.href.split(/[?#]/)[0]}#${i}" class="h2-link">${heading.textContent}</a>`
        }

        i++
    })
}
populateLinks()

document.addEventListener('scroll', () => {
    document.querySelectorAll('.main-content h1, .main-content h2, .main-content h3, .main-content h4, .main-content h5 ').forEach( e => {
        if(isInViewport(e)){
            document.querySelectorAll('.h1-link, .h2-link').forEach( a => a.classList.remove('current'))

            document.querySelector(`[href="${window.location.href.split(/[?#]/)[0]}#${e.id}"]`).classList.add('current')
        }
    })
})

function isInViewport(element) {
    const rect = element.getBoundingClientRect();
    return (
        rect.y >= -100 && rect.y <= 100
    );
}
</script>

