class Timer {
    constructor(dates = [2022, 11, 26], timerEl){
        this.date = dates
        this.UIdays = timerEl.querySelector(`.timer-day`)
        this.UIhours = timerEl.querySelector(`.timer-hour`)
        this.UIminutes = timerEl.querySelector(`.timer-minute`)
        this.UIseconds = timerEl.querySelector(`.timer-second`)
        this.targetDate;
        this.interval;
        this.timerEl = timerEl
    }

    start(){
        this.targetDate = new Date(Date.UTC(this.date[0], this.date[1] - 1, this.date[2] - 1, 23))

        this.interval = setInterval(() => { this.go() }, 200); 
                
    }

    go() {
        const _MS_PER_hour = 1000 * 60 * 60 ;
    
        const utc = new Date()
    
        const days = Math.floor(((this.targetDate - utc) / _MS_PER_hour)/ 24).toString()
        const hours = (Math.floor(((this.targetDate - utc) / _MS_PER_hour)) - (days*24)).toString()
        const minutes = (Math.floor(((this.targetDate - utc) / _MS_PER_hour) * 60) - (hours*60) - (days * 60 * 24)).toString()
        const seconds = (Math.floor(((this.targetDate - utc) / _MS_PER_hour) * 60 *60) - (minutes * 60) - (hours * 60 * 60) - (days * 60 * 60 * 24)).toString()
    
        this.UIdays.textContent = days.padStart(2, '0')
        this.UIhours.textContent = hours.padStart(2, '0')
        this.UIminutes.textContent = minutes.padStart(2, '0')
        this.UIseconds.textContent = seconds.padStart(2, '0')
    }

    stop(){
        clearInterval(this.interval);
    }

}


</script></div><div class="hidden w-embed w-script"><!--Request Demo Configs-->
<script>
document.getElementById("demo").addEventListener("click", function(e) {
    e.preventDefault();
    
    const baseHref = this.dataset.href;
    let targetUrl;
    
    try {
        // Always create base URL from data-href
        targetUrl = new URL(baseHref, window.location.href);
        
        // Set UTM parameters
        targetUrl.searchParams.set('utm_source', window.location.pathname);
        targetUrl.searchParams.set('utm_medium', 'landing');
        
        // Preserve existing parameters from data-href
        const baseUrlParams = new URLSearchParams(baseHref.split('?')[1] || '');
        baseUrlParams.forEach((value, key) => {
            if (!targetUrl.searchParams.has(key)) {
                targetUrl.searchParams.set(key, value);
            }
        });
        
        // Change this line to use window.location.href instead of window.open()
        window.location.href = targetUrl.toString();
        
    } catch (error) {
        console.error('Redirect error:', error);
        const fallbackUrl = new URL(this.href, window.location.href);
        // Also change this line
        window.location.href = fallbackUrl.toString();
    }
});
</script></div></div><div class="timer-date-selector-code w-embed w-script"><script>
