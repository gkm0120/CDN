    </tr>
    <tr>
      <td>2:15PM-3:10PM</td>
      <td>
<strong>Code Generation</strong><br>  <a href="/assets/program/tutorials/MLIR/HC2022.Nodai.Menon.pdf"><i class="fa fa-file-pdf fa-fw" aria-hidden="true"></i></a> <a href="https://youtu.be/VFexAjUoTZI?t=2861" target="_blank" rel="noopener noreferrer"><i class="fa fa-file-video fa-fw" aria-hidden="true"></i></a>
