      <script>window.__TRI_PAGE_STATE__={"kind":"page","id":"blank","slug":"blank","name":"product-detail","scenes":[{"id":"1","slug":"","title":""}],"collection":{"1":[{"kind":"block","name":"hero-prod","data":{"backgroundLayout":"picture","contentLayout":"default","title":"联网搜索API","desc":"联网搜索API（Web Search API，wsa）以互联网全网公开资源为基础，叠加腾讯优质内容生态，结合元宝APP联网搜索应用实践，从数据收录到智能检索召回，全链路构建AI友好搜索引擎。合作伙伴通过检索词发起请求，接口以JSON形式返回搜索结果对应的排序信息、数据字段，合作伙伴可在业务场景中结合搜索结果的内容，扩充信息内容源，丰富展现效果，提升用户的查询满意度。","abstract":"高速实时，内容丰富的联网搜索服务。","bgImage":"https://qcloudimg.tencent-cloud.cn/trisys/assets/product/images/d4dncawQL6cp7k9wHvhJ2.png","buttons":[{"title":"立即选购","to":"https://buy.cloud.tencent.com/buywsa","__vid__":"WdGUUVL4m3ORMk8y8UB7v"},{"title":"产品控制台","to":"https://console.cloud.tencent.com/wsapi/index","type":"doc","__vid__":"_hESAjO9lAKjEEGoBJhrl"}],"links":[{"title":"产品文档","to":"https://cloud.tencent.com/document/product/1806","__vid__":"b1aDO1Zjm1evEvXylxMBr"}]},"id":"8ISPlGQ5F"},{"kind":"block","name":"sale-list","data":{"appearance":"card","columns":2,"list":[{"title":"（元宝）联网搜索API旗舰版","region":"","specs":[],"features":["高级精排模型","公开网页信源","优质权威垂直信源（VR结果）","指定网址检索","指定时间范围检索","标准摘要","图片列表","结果返回条数5～10条","结果返回条数扩充至50条","动态摘要","指定垂域","附件子链信息","结果相关性得分","结果权威度等级"],"badge":"卓越效果","pricings":{"price":"80","unit":"元/千次","originalPrice":"","approximation":""},"button":{"title":"立即购买","to":"https://buy.cloud.tencent.com/buywsa"},"__vid__":"7ds23AdoSuPG9PCi0zVpN","subTitle":"仅限企业用户开通"},{"title":"（元宝）联网搜索API尊享版","region":"","specs":[],"features":["基础精排模型","公开网页信源","优质权威垂直信源（VR结果）","指定网址检索","指定时间范围检索","标准摘要","图片列表","结果返回条数5～20条","结果返回条数扩充至50条","动态摘要","指定垂域","结果相关性得分"],"badge":"尊享全能","pricings":{"price":"60","unit":"元/千次","originalPrice":"","approximation":""},"button":{"title":"立即购买","to":"https://buy.cloud.tencent.com/buywsa"},"__vid__":"P7aLY1IHm1yvmIeey1YHr","subTitle":"仅限企业用户开通"},{"title":"（元宝）联网搜索API标准版","region":"","specs":[],"features":["基础精排模型","公开网页信源","优质权威垂直信源（VR结果）","指定网址检索","指定时间范围检索","标准摘要","图片列表","结果返回条数5～20条","结果相关性得分"],"badge":"高性价比","pricings":{"price":"46","unit":"元/千次","originalPrice":"","approximation":"","specials":{"value":"","desc":""}},"button":{"title":"立即购买","to":"https://buy.cloud.tencent.com/buywsa"},"__vid__":"lkEr9v4Fa9FYJF1uLdZ7h"},{"title":"（元宝）联网搜索API轻量版","region":"","specs":[],"features":["轻量精排模型","公开网页信源","指定时间范围检索","标准摘要","图片列表","结果返回条数5～10条","结果相关性得分"],"badge":"极速体验","pricings":{"price":"18","unit":"元/千次","originalPrice":"","approximation":""},"button":{"title":"立即购买","to":"https://buy.cloud.tencent.com/buywsa"},"__vid__":"Fd-pMU3k3_p2IXNJSGNMY","subTitle":""}]},"logics":[],"id":"GeYpUkH7o","collection":{"header":[{"kind":"block","name":"section-header","data":{"title":"产品规格"},"logics":[],"id":"qO2PDWOP7c","collection":{}}]},"className":""},{"kind":"block","name":"feature-matrix","data":{"list":[{"icon":"https://cloudcache.tencent-cloud.com/qcloud/ui/static/tc_portal_icon/9b08b97d-693d-42c9-ba13-de431e76c863.png","title":"大模型友好","desc":"从数据收录到智能召回，全链路为大模型重新构建，信息自动去噪，节省Token成本，大模型可直接使用无需二次处理。","__vid__":"63Rvr31IKvV-ANeNid10k"},{"icon":"https://cloudcache.tencent-cloud.com/qcloud/ui/static/tc_portal_icon/e0849049-ebd8-46c0-86ca-abf84afb6800.png","title":"毫秒级响应","desc":"借助分布式计算+边缘节点缓存，最快300ms返回结果，实现快速稳定的高性能体验。\n","__vid__":"SUXZASt9Qua0z94c4cofz"},{"icon":"https://cloudcache.tencent-cloud.com/qcloud/ui/static/tc_portal_icon/971b5408-c19b-4de7-bfbb-6db21be4cf86.png","title":"分钟级更新","desc":"提供高时效性内容检索，实时获取政策更新、新闻动态、天气变化、实时行情等最新信息。","__vid__":"F2dS2FlbjQDAWop0o9-d3"},{"icon":"https://cloudcache.tencent-cloud.com/qcloud/ui/static/tc_portal_icon/12f9d881-89ae-4270-954d-8e35ad85b57b.png","title":"海量资源库","desc":"全网内容分层聚类精准索引，融合腾讯优质内容生态，包括腾讯新闻、搜狗百科、企鹅号等内容，覆盖各类优质资源。","__vid__":"7KEupFOiEn1lNI8FHseJU"}],"columns":4},"id":"-YVF9ArIr","collection":{"header":[{"kind":"block","name":"section-header","data":{"title":"产品特性"},"id":"zOg-VcSnAJ"}]},"className":"bg-gray"},{"kind":"block","name":"scene-media","data":{"tabs":[{"id":"2","label":"模型智答万物","content":{"image":"https://qcloudimg.tencent-cloud.cn/trisys/assets/product/images/MgirtwWhVEc9NquaNsZ80.png","intro":{"desc":"联网搜索API实时检索打破大模型知识过期的困局，让模型生成与事实核查同步进行，答案准确率从模糊推测跃升至溯源级精准，为用户提供更精准、更可信的答案。"},"features":{"title":"典型场景示例","lines":["AI搜索：借助联网搜索，AI搜索能够即刻更新其知识库，提供最新的行业数据、科研成果或市场趋势，用户在搜索时可获得实时、精准的信息支持，提升搜索体验。","智能对话助手：通过接入联网搜索，结合实时信息检索与大模型生成能力，能够准确理解并快速回应用户的多样化问题，为用户提供更精确的答案，解决因知识过期或不准确导致的常见问题。"]}},"__vid__":"1OJEwVEn0Jq8HEFuKd9TE"},{"id":"1","label":"智能办公提效","content":{"image":"https://qcloudimg.tencent-cloud.cn/trisys/assets/product/images/vTYcRZB-hnkXknfIxfdL0.png","intro":{"desc":"联网搜索API能支撑AI创作的文本生成、续写、改写等核心创作，自动检索最新行业数据、市场趋势、学术资料，为内容提供事实支撑和实时更新，助力工作全流程。"},"features":{"title":"典型场景示例","lines":["市场调研分析：通过联网搜索检索最新的市场数据和行业动态，帮助团队快速了解行业趋势、竞争对手情况和消费者需求，为决策提供精准依据，减少手动分析的时间成本。","学术报告生成：联网搜索通过实时更新的学术资料和行业研究数据，协助生成符合标准的学术报告或研究论文，帮助学术人员高效完成文献综述、数据分析及内容撰写，提升科研产出质量。"]}},"__vid__":"PsSLN5S48cSl5SyEYgoMa"},{"id":"4","label":"智慧座舱升级","content":{"image":"https://qcloudimg.tencent-cloud.cn/trisys/assets/product/images/nXLmdmHJmsMHS2frKLFey.png","intro":{"desc":"联网搜索API为汽车智能座舱赋予实时搜索能力，驾驶过程中可即时访问最新在线数据，准确获取景点信息、目的地天气等。帮助车辆实时响应用户语音查询的复杂指令，让行车体验更智能。"},"features":{"title":"典型场景示例","lines":["实时景点查询：通过接入联网搜索，驾驶过程中，车主可以随时询问周围的景点或休息站信息，系统通过实时搜索，提供精确的推荐和详细描述，帮助车主更好地规划休息和游玩。","目的地天气预报：接入联网搜索后，车主通过语音指令查询目的地的实时天气状况，系统提供即时准确的天气预报，帮助车主提前做好出行准备，避免天气突变影响行车安全。"]}},"__vid__":"788TmCmLodnxOpVdm50v1"},{"id":"b9zLdYLdwvaGja_DGjtPv","label":"智能硬件革新","content":{"image":"https://qcloudimg.tencent-cloud.cn/trisys/assets/product/images/6Ys6uj35iggkmXimJrkli.png","intro":{"desc":"智能硬件通过接入联网搜索API，可以实时接入生活百科、新闻资讯及个性化推荐系统的网络信息，显著提升了智能硬件交互响应精度与场景适应能力，实现用户需求精准匹配与操作效率双重升级。"},"features":{"title":"典型场景示例","lines":["智能语音助手：通过接入联网搜索，语音助手能够为用户提供最新的新闻、天气、日程安排等实时资讯，增强了语音助手的服务范围和实用性，提升用户交互体验。","儿童手表：通过联网搜索提供即时的新闻资讯、天气预报、教育资源等内容，帮助孩子了解世界、获取最新的知识和事件，提高他们的学习兴趣与认知能力。"]}},"__vid__":"dE3FUGch7AXPCLOPGIVz2"},{"id":"2Z9xpj4jKPUefGHCKhKdu","label":"更多","content":{"image":"https://qcloudimg.tencent-cloud.cn/trisys/assets/product/images/24ISV0yE9NKJO2mno9eUk.png","intro":{"desc":"联网搜索提供即时、精确的搜索结果，为各行各业提供快速、智能、准确的信息服务，探索全新的搜索体验。"},"features":{"title":"典型场景示例","lines":["金融科技应用：联网搜索实时检索市场数据与趋势，支持智能投资决策，提升金融分析和风险评估能力。","教育与在线学习：联网搜索为学生提供个性化学习资源推荐，支持课题研究和在线自学内容获取。","智能客服与问答系统：联网搜索能提升客服机器人与智能助理的响应效率和准确度，降低人工成本，提升用户体验。"]}},"__vid__":"fhsWqQsI4cRqgipB84CT7"}]},"id":"P0vwgZ7yg","collection":{"header":[{"kind":"block","name":"section-header","data":{"title":"应用场景"},"id":"yEI3DSeRF6"}]}},{"kind":"block","name":"cases-gallery","data":{"title":"客户案例","desc":"通过接入联网搜索，客户能够实时获取最新的全网信息，提升智能化水平，快速响应市场变化，确保在动态市场环境中保持领先，从而进一步提升业务运作的精度和速度，增强市场竞争力。","bgImage":"https://qcloudimg.tencent-cloud.cn/raw/7db1e437207315e9d9385bb24ae59a96.jpeg","cases":[{"logo":"https://qcloudimg.tencent-cloud.cn/trisys/assets/product/images/2Tts3ozI8jFYepM9TPA68.png","content":"接入联网搜索后，腾讯元宝打破了大模型知识过期的困局，当用户提问时效权威问题时，系统自动穿透全网权威信源，实时获取最新资讯、政府官网、政策文件，答案准确率从模糊推测跃升至溯源级精准。","by":"腾讯元宝","to":"","__vid__":"9jldRfhiZJc_f4ILxIprA"},{"logo":"https://qcloudimg.tencent-cloud.cn/trisys/assets/product/images/SvFL5pd-bO7rI64hXcux9.png","content":"QQ浏览器进行信息获取-处理-应用的全链路重构，整合AI搜索、智能浏览、多模态文档处理与智能体（Agent）任务执行等能力，重塑浏览器的功能边界与用户体验，将浏览器从被动检索工具升级为主动生产力伙伴。","by":"QQ浏览器","to":"","__vid__":"kj2ixtNWofMu6diIFSaHj"},{"logo":"https://qcloudimg.tencent-cloud.cn/trisys/assets/product/images/ydo_3eGA0xoJvifwlQaNa.png","content":"腾讯地图使用联网搜索为产品增加了用户信息获取宽度，通过实时数据整合​和场景化服务​，实现从“工具”到“生活助手”的升级。用户可随时获取动态信息，高效决策，降低出行成本，全面提升生活便利性。","by":"腾讯地图","to":"","__vid__":"EJSRSqmSINo4Gxu4AwMlh"}],"logos":[{"logo":"https://qcloudimg.tencent-cloud.cn/trisys/assets/product/images/b1lqWSdV1uSb-bL4rhqoJ.png","title":"快手","to":"","__vid__":"pJ30siPRS_gc_5_620_gT"},{"logo":"https://qcloudimg.tencent-cloud.cn/trisys/assets/product/images/oMw0Jpa-bAOEtSZZl57Rt.png","title":"晶泰科技","to":"","__vid__":"TM1QZopxRA_4r1_wR18PJ"},{"logo":"https://qcloudimg.tencent-cloud.cn/trisys/assets/product/images/Wj4vowttx1Zc3u_vmAY5v.png","title":"人民网","to":"","__vid__":"bcPsYKv-WhDg7FqEh2-4r"}]},"logics":[],"id":"EPSiqIF6Z","collection":{}},{"kind":"block","name":"documents","data":{"documents":[{"title":"产品简介","desc":"帮助您快速了解联网搜索API服务的概述、优势、应用场景等。","to":"https://cloud.tencent.com/document/product/1806/121794","__vid__":"-dU6EGn_bC1bIYAv8ZgI7"},{"title":"使用指南","desc":"帮助您快速开通、接入联网搜索API服务。","to":"https://cloud.tencent.com/document/product/1806/121802","__vid__":"wyrHVeQ40cYZrGMmqdU83"},{"title":"计费模式","desc":"支持按量计费（后付费）和资源包（预付费）两种计费模式。","to":"https://cloud.tencent.com/document/product/1806/121798","__vid__":"WoPC_Nw2tNE2b_VnY_VOJ"}],"columns":{"default":3}},"id":"QF1fHud9z","collection":{"header":[{"kind":"block","name":"section-header","data":{"title":"帮助与文档"},"id":"PdaubF67_3"}]},"className":""},{"kind":"block","name":"faq-list","data":{"list":[{"question":"什么是联网搜索API？","answer":{"mod":"slate","content":[{"type":"p","children":[{"text":"联网搜索（Web Search API，wsa）来源于搜狗搜索，以互联网全网公开资源为基础，实现了从收录至召回排序全链路的智能搜索增强。合作伙伴通过检索词请求接口，以 JSON 形式返回搜索结果对应的排序信息、数据字段。同时合作伙伴可在业务场景中结合搜索结果的内容，扩充信息内容源，丰富展现效果，提升用户的查询满意度。"}]}]},"__vid__":"gSRhuAG5eyCaRMXIExrTD"},{"question":"如何开始使用联网搜索API？","answer":{"mod":"slate","content":[{"type":"p","children":[{"text":"为了方便您有效地使用联网搜索API，您可以通过阅读产品文档中的"},{"type":"link","url":"https://cloud.tencent.com/document/product/1806/121802","title":"https://cloud.tencent.com/document/product/1806/121802","children":[{"text":"快速入门"}]},{"text":"和"},{"type":"link","url":"https://cloud.tencent.com/document/product/1806/121811","title":"https://cloud.tencent.com/document/product/1806/121811","children":[{"text":"API文档"}]},{"text":"，快速接入联网搜索API。"}]}]},"__vid__":"uuxhV9deP7XVMQQ8aauZs"},{"question":"为什么子账号调用后显示未授权？","answer":{"mod":"slate","content":[{"type":"p","children":[{"text":"联网搜索API产品必须通过主账号开通。主账号为子账号授权后，子账号即可获得调用权限。"}]}]},"__vid__":"quB5f1y-QJru5jXiNF2IA"},{"question":"是否可以直接使用主账号接入测试？","answer":{"mod":"slate","content":[{"type":"p","children":[{"text":"可以。子账号是出于不同业务权限的考量，如果只有一个业务，可以直接使用主账号。"}]}]},"__vid__":"7NncRUGmgcpzDJxfVQ1Co"},{"question":"为什么显示开通失败？","answer":{"mod":"slate","content":[{"type":"p","children":[{"text":"请确保您的账号处于未欠费状态，欠费状态的账号无法开通产品。"}]}]},"__vid__":"UEhxzCXdtENYTHE45pluc"}]},"logics":[],"id":"yCLcHRE33","collection":{"header":[{"kind":"block","name":"section-header","data":{"title":"常见问题"},"logics":[],"id":"sVfH94GfR8","collection":{}}],"addons":[{"kind":"block","name":"section-footer","data":{"content":{"mod":"slate","content":[{"type":"topic","children":[{"type":"p","children":[{"text":"更多问题请查看 "},{"type":"link","url":"https://cloud.tencent.com/document/faq","title":"https://cloud.tencent.com/document/faq","children":[{"text":"常见问题"}]},{"text":"，也可在 "},{"type":"link","url":"https://cloud.tencent.com/developer/ask","title":"https://cloud.tencent.com/developer/ask","children":[{"text":"问答社区"}]},{"text":" 中进行提问 。"}]}],"id":"2270e8ed-9c1b-4fd9-be82-74d07b7387ee"}]}},"logics":[],"id":"Q8UKPGOEz-","collection":{}}]},"className":"bg-gray"},{"kind":"block","name":"call2action","data":{"title":"","content":"按照我们的使用指南，开通服务后，即可调用联网搜索API。","buttons":[{"title":"开始使用","to":"https://console.cloud.tencent.com/wsapi/index","__vid__":"31n2A5QHOTKkGo-j23olR"}],"aside":{"qrcodes":[{"image":"https://qcloudimg.tencent-cloud.cn/trisys/assets/product/images/S_OuQUeeiDtQwlqjDXCZD.png","title":"腾讯联网搜索API产品交流群","__vid__":"YSYOEAa4MwB1WqcLS4CHJ"}],"content":"如果您有任何使用上的问题障碍或者建议，欢迎扫码入群和我们交流。"}},"logics":[],"id":"UTpySBVfZ","collection":{}}]},"settings":{"seo":{"title":"联网搜索API_大模型联网搜索_智能搜索增强- 腾讯云","keywords":"联网搜索API,大模型联网搜索,智能搜索增强,搜狗搜索接口,搜狗搜索API,JSON数据接口,搜索结果增强","description":"联网搜索API来源于搜狗搜索，以全互联网公开资源为基础，实现了从收录至召回排序全链路的智能搜索增强。合作伙伴通过检索词请求接口，以JSON形式返回搜索结果对应的排序信息、数据字段，可在业务场景中结合搜索结果的内容，扩充信息内容源，丰富展现效果，提升用户的查询满意度。"},"siteSearch":{"enable":true}}};</script>
    
